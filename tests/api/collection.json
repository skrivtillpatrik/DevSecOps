{
  "info": {
    "name": "Cowork API Tests",
    "_postman_id": "cowork-tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET all users",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
     {
      "name": "Create user",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Test User\"}"
        },
        "url": "{{baseUrl}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response contains id\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.id).to.exist;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Login User",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Spara session-cookie",
              "let cookie = pm.response.headers.get(\"Set-Cookie\");",
              "pm.environment.set(\"sessionCookie\", cookie);",
              "",
              "pm.test(\"Login succeeded\", function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Calendar Event",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Cookie", "value": "{{sessionCookie}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Testmöte\",\n  \"description\": \"API-test\",\n  \"dateStart\": \"2026-03-10T10:00:00\",\n  \"dateEnd\": \"2026-03-10T11:00:00\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/calendar",
          "host": ["{{baseUrl}}"],
          "path": ["api", "calendar"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Spara eventId",
              "let json = pm.response.json();",
              "pm.environment.set(\"eventId\", json.id);",
              "",
              "pm.test(\"Event created\", function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update Calendar Event",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Cookie", "value": "{{sessionCookie}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Uppdaterat möte\",\n  \"description\": \"API-test uppdaterad\",\n  \"dateStart\": \"2026-03-10T10:30:00\",\n  \"dateEnd\": \"2026-03-10T11:30:00\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/calendar/{{eventId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "calendar", "{{eventId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Event updated\", function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete Calendar Event",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Cookie", "value": "{{sessionCookie}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/calendar/{{eventId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "calendar", "{{eventId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Event deleted\", function () {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ]
}
